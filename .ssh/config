Host stud
    HostName login.stud.ntnu.no
    User noervaag

Host dovre
    HostName dovre.idi.ntnu.no
    User noervaag
    ProxyJump stud

Host dascosa01
    HostName dascosa
    User noervaag
    ProxyJump dovre

Host dascosa
    HostName dascosa
    User noervaag
    ProxyJump dovre

Host dascosa-tunnels
    HostName dascosa
    User noervaag
    ProxyJump dovre
    # Plain forwards (http://localhost:PORT)
    LocalForward 9870  dascosa02:9870
    LocalForward 8088  dascosa03:8088
    LocalForward 16010 dascosa02:16010
    LocalForward 3000  dascosa01:3000
    LocalForward 9090  dascosa01:9090
    LocalForward 18080 dascosa01:18080
    LocalForward 10002 dascosa01:10002
    # SOCKS proxy: makes links between nodes work in the web UIs
    DynamicForward 1080
    ServerAliveInterval 30
    ServerAliveCountMax 3
    ExitOnForwardFailure yes

Host *
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m
    
